{
  "name": "Playwright Test with Gherkin + Data Table",
  "prefix": "playwright-test-table",
  "description": "Playwright test scaffold with Gherkin and Examples table for data-driven testing",
  "body": [
    "/**",
    " * Feature: ${1:User Login}",
    " * Scenario Outline: ${2:Login with multiple user credentials}",
    " *   Given the user is on the login page",
    " *   When the user enters <username> and <password>",
    " *   Then the user should see a personalized welcome message",
    " *",
    " * Examples:",
    " *   | username   | password   |",
    " *   | ${3:user1} | ${4:pass1} |",
    " *   | ${5:user2} | ${6:pass2} |",
    " */",
    "",
    "import { test, expect } from '@playwright/test';",
    "",
    "const users = [",
    "  { username: '${3:user1}', password: '${4:pass1}' },",
    "  { username: '${5:user2}', password: '${6:pass2}' },",
    "];",
    "",
    "for (const user of users) {",
    "  test(`login as ${7:scenario description} - ${user.username}`, async ({ page }) => {",
    "    // Navigate to login page",
    "    await page.goto('${8:https://example.com/login}');",
    "",
    "    // Fill in username",
    "    await page.getByRole('textbox', { name: 'Username' }).fill(user.username);",
    "",
    "    // Fill in password",
    "    await page.getByRole('textbox', { name: 'Password' }).fill(user.password);",
    "",
    "    // Click login",
    "    await page.getByRole('button', { name: 'Log in' }).click();",
    "",
    "    // Expect welcome message or dashboard redirect",
    "    await expect(page).toHaveURL('${9:https://example.com/dashboard}');",
    "  });",
    "}"
  ]
}
