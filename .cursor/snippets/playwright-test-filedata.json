{
    "name": "Playwright Test with Gherkin + JSONL Data",
    "prefix": "playwright-test-filedata",
    "description": "Playwright test scaffold using Gherkin and external .jsonl dataset",
    "body": [
      "/**",
      " * Feature: ${1:Bulk User Login}",
      " * Scenario: ${2:Login using credential set from external dataset}",
      " *   Given the user is on the login page",
      " *   When the user logs in using credentials from \"${3:login_data.jsonl}\"",
      " *   Then each user should be redirected to their dashboard",
      " *",
      " * Data file: ${3:login_data.jsonl}",
      " * Each line should be a JSON object like:",
      " *   { \"username\": \"user1\", \"password\": \"pass1\" }",
      " */",
      "",
      "import { test, expect } from '@playwright/test';",
      "import fs from 'fs';",
      "",
      "// Load test data from .jsonl file",
      "const dataLines = fs.readFileSync('${3:login_data.jsonl}', 'utf-8').trim().split('\\n');",
      "const credentials = dataLines.map(line => JSON.parse(line));",
      "",
      "for (const user of credentials) {",
      "  test(`login test for ${user.username}`, async ({ page }) => {",
      "    // Navigate to login page",
      "    await page.goto('${4:https://example.com/login}');",
      "",
      "    // Fill in username",
      "    await page.getByRole('textbox', { name: 'Username' }).fill(user.username);",
      "",
      "    // Fill in password",
      "    await page.getByRole('textbox', { name: 'Password' }).fill(user.password);",
      "",
      "    // Click login button",
      "    await page.getByRole('button', { name: 'Log in' }).click();",
      "",
      "    // Expect dashboard redirect",
      "    await expect(page).toHaveURL('${5:https://example.com/dashboard}');",
      "  });",
      "}"
    ]
  }
  